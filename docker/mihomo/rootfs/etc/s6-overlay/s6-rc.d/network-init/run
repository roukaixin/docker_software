#!/usr/bin/execlineb -S0

foreground { ip rule add fwmark 0x1/0x1 lookup 100 }
foreground { ip route add local default dev lo table 100 }
foreground { ip -6 rule add fwmark 0x1 lookup 106 }
foreground { ip -6 route add local ::/0 dev lo table 106 }

foreground { echo 1 > /proc/sys/net/ipv4/ip_forward }
foreground { echo 1 > /proc/sys/net/ipv6/conf/all/forwarding }
foreground { iptables -t nat -A POSTROUTING -m mark --mark 0x2/0x2 -j MASQUERADE }
foreground { ip6tables -t nat -A POSTROUTING -m mark --mark 0x2/0x2 -j MASQUERADE }
